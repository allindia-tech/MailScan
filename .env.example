# ==============================================================================
# MailTrace AI — Environment Configuration Template
# ==============================================================================

# GEMINI_API_KEY: Optional API key for Gemini LLM copilot and advanced reasoning.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: Base URL where MailTrace is hosted.
APP_URL="http://localhost:3000"

# ==============================================================================
# Google Cloud Storage & Machine Learning Model Configuration
# ==============================================================================

# MAILTRACE_MODEL_BUCKET: GCS bucket containing the 1.4 GB model artifact.
# Example: "my-gcp-project-mailtrace-models"
MAILTRACE_MODEL_BUCKET="my-gcp-project-mailtrace-models"

# MAILTRACE_MODEL_OBJECT: Path to the model artifact inside the GCS bucket.
# Default: "models/mailtrace-100m-v2/mailtrace-100m-v2.pt"
MAILTRACE_MODEL_OBJECT="models/mailtrace-100m-v2/mailtrace-100m-v2.pt"

# MAILTRACE_MODEL_VERSION: Semantic version of the production model artifact.
MAILTRACE_MODEL_VERSION="100m-v2"

# MAILTRACE_MODEL_DIR: Local cache directory for the downloaded checkpoint.
# Default on Cloud Run: "/tmp/mailtrace-model"
MAILTRACE_MODEL_DIR="/tmp/mailtrace-model"

# MAILTRACE_MODEL_PATH: Optional explicit local path to an existing .pt checkpoint (Mode A - Local Dev).
# MAILTRACE_MODEL_PATH="./checkpoints/mailtrace-100m-v2.pt"

# ML_INFERENCE_URL: URL of the Python inference service (default: http://127.0.0.1:5001).
ML_INFERENCE_URL="http://127.0.0.1:5001"
