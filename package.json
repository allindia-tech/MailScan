{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "model:setup": "python3 scripts/model_setup.py",
    "package:extension": "node scripts/generate-icons.js && node scripts/package-extension.js",
    "build": "node scripts/generate-icons.js && node scripts/package-extension.js && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "dataset:prepare": "python3 ml/data/prepare_dataset.py",
    "dataset:verify": "python3 ml/data/verify_dataset.py",
    "train": "python3 ml/training/train_splits.py",
    "evaluate": "python3 ml/training/evaluate_splits.py",
    "evaluate:smoke": "python3 ml/training/evaluate_splits.py --smoke",
    "test": "tsx server/testing/runAllTests.ts",
    "test:all": "tsx server/testing/runAllTests.ts",
    "test:regression": "tsx server/regressionTestSuite.ts",
    "test:mailtrace": "tsx server/testing/runAllTests.ts",
    "test:mailtrace:dataset": "tsx -e \"import { TestDatasetLoader } from './server/testing/testDatasetLoader.js'; console.log(JSON.stringify(new TestDatasetLoader().getQualityReport(), null, 2));\"",
    "test:mailtrace:regression": "tsx server/regressionTestSuite.ts",
    "test:mailtrace:determinism": "tsx server/testing/determinismTest.ts",
    "test:mailtrace:security": "tsx server/testing/securityIsolationTest.ts",
    "test:mailtrace:all": "tsx server/testing/runAllTests.ts",
    "test:feedback": "tsx scripts/test_feedback_pipeline.ts",
    "test:model": "python3 scripts/forensic_model_verification.py"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "archiver": "^8.0.0",
    "d3": "^7.9.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "topojson-client": "^3.1.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/topojson-client": "^3.1.5",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
